# Atenção: o desenvolvimento local aponta para a API REAL em produção no Render.
# Cadastro, fila, prescrições e alterações atingem o banco de produção.
# Não execute seeds, E2E com dados falsos ou testes mutáveis contra esse backend.
API_PROXY_TARGET=https://av-backend-rlc1.onrender.com
VITE_AV_LOCAL_API=true

# Manter VITE_AV_API_ORIGIN ausente: o Vite usa o proxy local same-origin.
# No deploy Vercel, vercel.json encaminha /api/* ao Render do lado do servidor.
# Não é necessário habilitar CORS para localhost ou preview da Vercel.

# Apenas demonstração legada e testes isolados.
LEGACY_AUTH_PROXY_TARGET=http://127.0.0.1:3001

# NUNCA coloque DATABASE_URL, AUTH_JWT_SECRET, tokens ou senhas em VITE_*.
