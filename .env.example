# Desenvolvimento local: o proxy do Vite encaminha /api/v1/* para o backend.
# Para usar a API em produção localmente, execute:
#   npm run config:api -- https://SUA-API-DE-PRODUCAO
# Isso cria .env.local (ignorado no Git) e ativa o modo API real.
API_PROXY_TARGET=http://127.0.0.1:3000
VITE_AV_LOCAL_API=true

# Apenas no deploy público (configurar em Vercel > Environment Variables):
# VITE_AV_API_ORIGIN=https://SUA-API-DE-PRODUCAO
# Deixe VITE_AV_API_ORIGIN sem valor no desenvolvimento local para usar o proxy
# same-origin e não exigir CORS com http://localhost:5173.

# Usado apenas na demonstração legada.
LEGACY_AUTH_PROXY_TARGET=http://127.0.0.1:3001

# NÃO coloque segredos JWT, DATABASE_URL ou tokens privados em VITE_*.
