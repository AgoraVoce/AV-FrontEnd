+import { Router } from 'express';
+import type { ApiDependencies } from '../config/runtime.js';
+import { authenticate } from '../middlewares/authenticate.js';
+import { authorize } from '../middlewares/authorize.js';
+import { managementControllers } from '../controllers/management.controller.js';
+export function managementRoutes(deps: () => ApiDependencies) {
+  const router = Router(), auth = authenticate(deps), admin = authorize('ADMIN'), doctor = authorize('MEDICO'), c = managementControllers(deps);
+  router.get('/specialties', auth, authorize('ADMIN','MEDICO','RECEPCIONISTA'), c.specialties);
+  router.post('/specialties', auth, admin, c.createSpecialty);
+  router.patch('/specialties/:id', auth, admin, c.updateSpecialty);
+  router.delete('/specialties/:id', auth, admin, c.deleteSpecialty);
+  router.get('/rooms', auth, admin, c.rooms);
+  router.post('/rooms', auth, admin, c.createRoom);
+  router.patch('/rooms/:id', auth, admin, c.updateRoom);
+  router.delete('/rooms/:id', auth, admin, c.deleteRoom);
+  router.get('/admin/doctors', auth, admin, c.doctors);
+  router.post('/admin/doctors', auth, admin, c.createDoctor);
+  router.patch('/admin/doctors/:id', auth, admin, c.updateDoctor);
+  router.get('/doctors/me/profile', auth, doctor, c.ownProfile);
+  router.get('/doctors/me/shifts', auth, doctor, c.ownShifts);
+  router.get('/admin/shifts', auth, admin, c.shifts);
+  router.post('/doctors/:id/shifts/series', auth, admin, c.series);
+  return router;
+}
