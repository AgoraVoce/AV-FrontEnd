+++ b/src/controllers/management.controller.ts
@@ -0,0 +1,27 @@
+import type { RequestHandler } from 'express';
+import type { ApiDependencies } from '../config/runtime.js';
+import type { User } from '../models/contracts.js';
+import { idParams, pageQuery } from '../validators/clinic.validator.js';
+import * as v from '../validators/management.validator.js';
+import { createManagementService } from '../services/management.service.js';
+export function managementControllers(deps: () => ApiDependencies) {
+  const model = () => { const m = deps().management; if (!m) throw new Error('Management model not configured'); return createManagementService(m); };
+  const handlers: Record<string, RequestHandler> = {
+    specialties: async (req,res,next) => { if (!deps().management) return next(); const q = pageQuery.parse(req.query); res.json(await model().specialties(q.page,q.pageSize)); },
+    createSpecialty: async (req,res) => { res.status(201).json(await model().saveSpecialty(v.specialtyInput.parse(req.body))); },
+    updateSpecialty: async (req,res) => { res.json(await model().saveSpecialty(v.specialtyInput.parse(req.body),idParams.parse(req.params).id)); },
+    deleteSpecialty: async (req,res) => { await model().deleteSpecialty(idParams.parse(req.params).id); res.status(204).end(); },
+    rooms: async (_req,res) => { res.json(await model().rooms()); },
+    createRoom: async (req,res) => { res.status(201).json(await model().saveRoom(v.roomInput.parse(req.body))); },
+    updateRoom: async (req,res) => { res.json(await model().saveRoom(v.roomInput.parse(req.body),idParams.parse(req.params).id)); },
+    deleteRoom: async (req,res) => { await model().deleteRoom(idParams.parse(req.params).id); res.status(204).end(); },
+    doctors: async (req,res) => { res.json(await model().doctors(v.directoryQuery.parse(req.query))); },
+    createDoctor: async (req,res) => { const { password, ...input } = v.professionalCreate.parse(req.body); res.status(201).json(await model().createDoctor(input, password)); },
+    updateDoctor: async (req,res) => { res.json(await model().saveDoctor(v.professionalInput.parse(req.body), undefined, idParams.parse(req.params).id)); },
+    ownProfile: async (_req,res) => { res.json(await model().ownProfile((res.locals.user as User).id)); },
+    ownShifts: async (_req,res) => { res.json(await model().shifts((res.locals.user as User).id)); },
+    shifts: async (_req,res) => { res.json(await model().shifts()); },
+    series: async (req,res) => { res.status(201).json(await model().createSeries(idParams.parse(req.params).id, v.seriesInput.parse(req.body))); },
+  };
+  return handlers;
+}
