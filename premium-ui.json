{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "pt-BR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Form", "Scrollbar", "Toast"],
  "requiredCommands": ["lint", "unit", "build", "tokens", "design"],
  "commands": {
    "lint": "npm run lint",
    "unit": "npm test",
    "build": "npm run build",
    "tokens": "npm run tokens:check",
    "design": "npm run design:lint"
  },
  "evidence": {
    "failurePaths": "tests/auth.spec.ts",
    "recoveryFailurePaths": "tests/recovery.spec.ts"
  }
}
